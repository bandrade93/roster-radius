{
  "name": "roster-radius",
  "description": "RosterRadius: open-source tool that maps which vendors receive which student data in U.S. K-12 school districts and measures each vendor's exposure.",
  "scripts": {
    "dev": "npm run dev -w @roster-radius/web",
    "build": "npm run build -w @roster-radius/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web",
    "synthetic": "tsx scripts/generate-synthetic.ts",
    "fields": "tsx scripts/generate-fields.ts"
  },
  "keywords": [
    "k12",
    "student-privacy",
    "student-data",
    "oneroster",
    "edtech",
    "data-minimization",
    "vendor-risk"
  ],
  "author": "Bruno Persona Negrão de Andrade",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/web"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
